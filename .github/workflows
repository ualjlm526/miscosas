name: Tests for INSO repository
run-name: ${{ github.actor }} is executing the tests
on: [push]
jobs:
  test:
    name: Test Build
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@v5
        with:
          path: main

      - name: Checkout repo with tests
        uses: actions/checkout@v5
        with:
          repository: ualinso/INSO-tests
          path: INSO-tests

      - name: Test execution
        working-directory: ./INSO-tests/inso2627
        run: mvn -B -ntp -q test

      - name: Resumen por ejercicio
        if: always()
        run: cat INSO-tests/inso2627/target/resumen-tests.md >> "$GITHUB_STEP_SUMMARY"
